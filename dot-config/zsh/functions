#!/usr/bin/env zsh

# HELPERS
_is_in_git_repo() {
  git rev-parse HEAD > /dev/null 2>&1
}

# GIT — pickers

# fgt — pick files (staged / unstaged / modified / all)
fgt() {
  _is_in_git_repo || return 1

  local mode="modified"
  while getopts ":sum" opt; do
    case $opt in
      s) mode="staged" ;;
      u) mode="unstaged" ;;
      m) mode="modified" ;;
      *) mode="all" ;;
    esac
  done
  shift $((OPTIND - 1))

  case "$mode" in
    staged)   git diff --name-only --cached ;;
    unstaged) git diff --name-only ;;
    modified) git diff --name-only; git diff --name-only --cached ;;
    all)      git ls-files ;;
  esac | sort -u | fzf --query "${*:-}" --multi \
    --height=80% --layout=reverse --border \
    --preview 'git diff --color=always -- {}'
}

fgt-widget() {
  local -a files
  local out

  out="$(fgt)" || { zle reset-prompt; return 0; }
  [[ -n $out ]] || { zle reset-prompt; return 0; }

  files=("${(@f)out}")
  LBUFFER+="${LBUFFER:+ }${(j: :)${(q-)files[@]}}"
  zle reset-prompt
}
zle -N fgt-widget

# fgst — pick from `git status`
fgst() {
  _is_in_git_repo || return 1
  local selection preview_cmd
  # first 3 chars = status codes; rest = path (may contain " -> " for renames)
  preview_cmd='
    f=$(printf "%s" {} | cut -c4- | sed "s/.* -> //")
    if git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
      git diff --color=always -- "$f"
      git diff --color=always --cached -- "$f"
    else
      bat --color=always --style=numbers "$f" 2>/dev/null || cat -- "$f"
    fi'
  selection=$(git -c color.status=always status --short |
    fzf --height 80% -m --ansi --nth 2..,.. \
        --preview "$preview_cmd" \
        --preview-window right:60%) || return 0
  # strip status codes, resolve renames → clean paths
  echo "$selection" | sed -E 's/^...//; s/.* -> //'
}

fgst-widget() {
  _is_in_git_repo || { zle reset-prompt; return 0; }
  local out
  out="$(fgst)" || { zle reset-prompt; return 0; }
  [[ -n $out ]] || { zle reset-prompt; return 0; }
  local -a files=("${(@f)out}")
  LBUFFER+="${LBUFFER:+ }${(j: :)${(q-)files[@]}}"
  zle reset-prompt
}
zle -N fgst-widget

# fgll — pick a commit hash from `git log`
fgll() {
  _is_in_git_repo || return 1
  local selection
  selection=$(git log --date=short --format="%C(green)%C(bold)%cd %C(auto)%h%d %s (%an)" --graph |
    fzf --height 40% --ansi --no-sort --reverse --multi \
        --preview 'grep -o "[a-f0-9]\{7,\}" <<< {} | head -1 | xargs git show --color=always' \
        --preview-window right:60%) || return 0
  echo "$selection" | grep -o '[a-f0-9]\{7,\}'
}

# fgtg — pick a git tag
fgtg() {
  _is_in_git_repo || return 1
  git tag --sort -version:refname |
    fzf --height 40% --multi \
        --preview 'git show --color=always {} | head -50' \
        --preview-window right:60%
}

# gsw — switch branch (fuzzy pick unless master/develop)
gsw() {
  _is_in_git_repo || return 1

  if [[ $1 == master || $1 == develop ]]; then
    git switch "$1"
    return
  fi

  local branch
  branch=$(git branch -a -vv --color=always | grep -v '/HEAD\s' |
    fzf --height 40% --ansi --tac --query="$1" \
        --preview "git log --oneline --graph --date=short --color=always --pretty='format:%C(auto)%cd %h%d %s' \$(sed 's/^..//' <<< {} | awk '{print \$1}' | sed 's#^remotes/[^/]*/##') --" \
        --preview-window right:50%) || return 0

  [[ -n $branch ]] || return 0
  branch=$(echo "$branch" | sed 's/^..//' | awk '{print $1}' | sed 's#^remotes/[^/]*/##')
  git switch "$branch"
}

gsw-widget() {
  _is_in_git_repo || { zle reset-prompt; return 0; }
  zle -I
  gsw
  zle reset-prompt
}
zle -N gsw-widget

# PROCESS

# fkill — pick + kill process (default SIGKILL, override: fkill 15)
fkill() {
  local pid
  if [[ $UID != 0 ]]; then
    pid=$(ps -f -u "$UID" | sed 1d | fzf -m --preview='' | awk '{print $2}')
  else
    pid=$(ps -ef | sed 1d | fzf -m --preview='' | awk '{print $2}')
  fi
  [[ -n $pid ]] && kill "-${1:-9}" ${=pid}
}

fkill-widget() {
  zle -I
  fkill
  zle reset-prompt
}
zle -N fkill-widget

# topmem — top RSS consumers
topmem() {
  ps -eo pid,ppid,rss,%mem,%cpu,command -m | head
}

# SEARCH / DOCS

# fman — fuzzy man/tldr picker (Enter → `man <cmd>`)
fman() {
  man -k . | sort |
    sed -E 's/^([^[:space:]]+)\([^)]+\),?/\1/' |
    awk -v cyan="$(tput setaf 6)" -v blue="$(tput setaf 4)" \
        -v res="$(tput sgr0)" -v bld="$(tput bold)" \
        '{ $1=cyan bld $1; $2=res blue } 1' |
    fzf \
      -q "${1:-}" \
      --ansi \
      --tiebreak=begin \
      --prompt=' Man > ' \
      --preview-window '50%,rounded,<50(up,85%,border-bottom)' \
      --preview "tldr --color=always {1} 2>/dev/null" \
      --bind 'enter:become(man {1})'
}

fman-widget() {
  zle -I
  fman
  zle reset-prompt
}
zle -N fman-widget

# spell — dict.org lookup, C-n cycles source, selection → clipboard
spell() {
  local q="${*:-}"
  local w src_file words_file

  if [[ -r /usr/share/dict/words ]]; then
    words_file=/usr/share/dict/words
  elif [[ -r /usr/dict/words ]]; then
    words_file=/usr/dict/words
  else
    echo "spell: no words file found (/usr/share/dict/words)" >&2
    return 1
  fi

  src_file=$(mktemp -t "spell-src.XXXXXX") || return
  echo wn > "$src_file"

  # preview: $1=word, $2=state file → prints definition + current source label
  local preview='src=$(cat "$2"); curl -s --max-time 3 "dict://dict.org/d:$1:$src" 2>/dev/null | tr -d "\r" | sed -E "/^[0-9][0-9][0-9] /d;/^\.$/d" | rg --passthru --color=always "\x7b[^\x7d]+\x7d"; printf "\n── %s ──\n" "$src"'

  # cycle: rotate source in $1 (state file). wn → moby-thesaurus → gcide → foldoc → jargon → pt → es → de → wn
  local cycle='s=$(cat "$1"); case "$s" in
    wn) n=moby-thesaurus ;;
    moby-thesaurus) n=gcide ;;
    gcide) n=foldoc ;;
    foldoc) n=jargon ;;
    jargon) n=fd-eng-por ;;
    fd-eng-por) n=fd-eng-spa ;;
    fd-eng-spa) n=fd-eng-deu ;;
    *) n=wn ;;
  esac
  echo "$n" > "$1"'

  w=$(fzf --query "$q" --ansi \
        --height=80% --layout=default --preview-window=up:60%:wrap --border \
        --header 'C-n = cycle source (WN → Moby-Thesaurus → GCIDE → Foldoc → Jargon → PT → ES → DE)' \
        --preview "sh -c ${(qq)preview} _ {} $src_file" \
        --bind "ctrl-n:execute-silent(sh -c ${(qq)cycle} _ $src_file)+refresh-preview" \
        <"$words_file")
  local rc=$?

  # print current-source definition to stdout
  [[ $rc -eq 0 && -n $w ]] && sh -c "$preview" _ "$w" "$src_file"

  \rm -f -- "$src_file"

  [[ $rc -ne 0 || -z $w ]] && return

  # copy selected word to clipboard
  printf '%s' "$w" | __clip_copy 2>/dev/null
}

# rgi — grep for STRING, pick from matching files with hit-preview
rgi() {
  if [[ $# -eq 0 ]]; then
    echo "Need a string to search for!"
    return 1
  fi
  rg --files-with-matches --no-messages "$1" |
    fzf --preview "
      highlight -O ansi -l {} 2> /dev/null |
      rg --colors 'match:bg:yellow' \
         --ignore-case \
         --pretty \
         --context 10 '$1' \
      || rg --ignore-case \
            --pretty \
            --context 10 '$1' \
            {}"
}

# vrg — rgi → open selected files in nvim
vrg() {
  local out; out=$(rgi "$@") && [[ -n $out ]] && nvim -- "${(@f)out}"
}

# NAVIGATION

# fcd — fuzzy directory jump (default root: $HOME)
fcd() {
  local searchdir destdir
  searchdir="${1:-$HOME}"
  destdir=$(
    fd --type d \
       --hidden \
       --exclude .git \
       --exclude __pycache__ \
       . "$searchdir" | fzf
  )
  [[ -z $destdir ]] && return 1
  cd "$destdir" || return 1
}

# mkcd — mkdir -p + cd
mkcd() {
  mkdir -p -- "$1" && cd -- "$1" || return
}

# cdtemp — cd into a fresh mktemp -d (0700), optional subdir
cdtemp() {
  local dir
  dir="$(mktemp -d)" || return
  chmod 0700 "$dir"
  cd -- "$dir" || return
  if [[ $# -eq 1 ]]; then
    mkdir -p -- "$1" && cd -- "$1" && chmod 0700 .
  fi
}

# y — yazi with cwd-hop on exit
y() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [[ -n $cwd && $cwd != $PWD ]]; then
    cd -- "$cwd" || return 1
  fi
  \rm -f -- "$tmp"
}

# FILES / MAINTENANCE

# delete-broken-symlinks — recursively rm dangling symlinks under CWD
delete-broken-symlinks() {
  find . -type l ! -exec test -e {} \; -exec rm -v {} +
}

# json-beautify-inplace — pretty-print JSON, atomic rewrite
json-beautify-inplace() {
  local input="$1" tmp
  [[ -n $input ]] || { echo "usage: json-beautify-inplace <file>" >&2; return 2; }
  tmp="$(mktemp)" || return
  jq . -- "$input" > "$tmp" && \mv -- "$tmp" "$input" || { \rm -f -- "$tmp"; return 1; }
}

# json-beautify-sort-inplace — pretty-print JSON with sorted keys
json-beautify-sort-inplace() {
  local input="$1" tmp
  [[ -n $input ]] || { echo "usage: json-beautify-sort-inplace <file>" >&2; return 2; }
  tmp="$(mktemp)" || return
  jq -S . -- "$input" > "$tmp" && \mv -- "$tmp" "$input" || { \rm -f -- "$tmp"; return 1; }
}
