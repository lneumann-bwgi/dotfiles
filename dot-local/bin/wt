#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

# ---------------------------------------------------------------------------
# wt — git worktree helper
#
# Usage:
#   wt <branch> [base]   Create a worktree + branch, optionally from <base>
#   wt cd [branch]       Drop into a worktree; omit branch to pick via fzf
#   wt rm [-f] <branch>  Remove a worktree and delete its branch
#   wt cleanup           Remove worktrees whose commits are already integrated
#   wt ls                List all worktrees
#   wt -h                Show this help
# ---------------------------------------------------------------------------

# Colors only when stderr is a TTY and NO_COLOR is unset — agents pipe this.
if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  RESET=$'\033[0m'
  BOLD=$'\033[1m'
  RED=$'\033[0;31m'
  GREEN=$'\033[0;32m'
  CYAN=$'\033[0;36m'
  DIM=$'\033[2m'
else
  RESET='' BOLD='' RED='' GREEN='' CYAN='' DIM=''
fi
readonly RESET BOLD RED GREEN CYAN DIM

info() { printf '%s\n' "${CYAN}▸${RESET} $*" >&2; }
success() { printf '%s\n' "${GREEN}✓${RESET} $*" >&2; }
# die <message> [exit-code]  (default 1; use 2 for usage/not-found errors)
die() {
  local msg=$1 code=${2:-1}
  printf '%s\n' "${RED}✗${RESET} $msg" >&2
  exit "$code"
}

usage() {
  echo -e "${BOLD}wt${RESET} — git worktree helper"
  echo ""
  echo -e "  ${BOLD}wt <branch> [base]${RESET}   Create worktree; new branch from base if missing,"
  echo -e "                       check out existing local branch, or track origin/<branch>."
  echo -e "                       Branch prefix required: ${BOLD}feature/ hotfix/ bugfix/ release/ chore/${RESET}"
  echo -e "                       (also: feat/ fix/ ai/ claude/ copilot/ cursor/ codex/)"
  echo -e "                       Worktree dir uses <repo-name>-<name after the prefix>"
  echo -e "                       ${DIM}Default base is the remote integration branch for the"
  echo -e "                       prefix: hotfix/ and release/ -> origin/<default>, others ->"
  echo -e "                       origin/develop when it exists. Never the current HEAD.${RESET}"
  echo -e "  ${BOLD}wt cd [branch]${RESET}       Drop into a worktree (interactive shell); omit branch to"
  echo -e "                       pick one via fzf"
  echo -e "  ${BOLD}wt path <branch>${RESET}     Print worktree path (use: cd \$(wt path <branch>))"
  echo -e "  ${BOLD}wt rm [--force] <branch>${RESET}"
  echo -e "                       Remove worktree and delete its local branch. Refuses when"
  echo -e "                       the worktree is dirty or holds unpushed, unmerged commits;"
  echo -e "                       ${BOLD}--force${RESET} overrides both."
  echo -e "  ${BOLD}wt cleanup${RESET}           Remove worktrees whose commits are already in an integration"
  echo -e "                       branch (patch-id aware, so PR-rewritten merges count)"
  echo -e "  ${BOLD}wt ls${RESET}                List all worktrees"
  echo -e "  ${BOLD}wt -h${RESET}                Show this help"
}

# ---------------------------------------------------------------------------
# Guards
# ---------------------------------------------------------------------------

require_git_repo() {
  git rev-parse --show-toplevel &>/dev/null ||
    die "Not inside a git repository." 2
}

# Main repo root, even when run from inside a linked worktree.
repo_root() {
  dirname "$(git rev-parse --path-format=absolute --git-common-dir)"
}

require_prefix() {
  case "$1" in
  feature/* | feat/* | hotfix/* | bugfix/* | fix/* | release/* | chore/* | ai/* | claude/* | copilot/* | cursor/* | codex/*) ;;
  *) die "Branch '$1' missing required prefix: feature/ hotfix/ bugfix/ release/ chore/ ai/ claude/ copilot/ cursor/ codex/" 2 ;;
  esac
  local desc="${1#*/}"
  [[ "$desc" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] ||
    die "Branch description '$desc' must be lowercase-hyphenated (a-z0-9-)" 2
}

# Tell the terminal (OSC 7) about the new cwd before exec'ing a fresh shell.
# Needed because terminals like Ghostty only wire up cwd-tracking hooks into
# the original login shell; an exec'd child shell never re-emits them.
report_cwd() {
  # shellcheck disable=SC1003 # trailing \\ is the OSC string terminator (ST), not an escaped quote
  printf '\033]7;file://%s%s\033\\' "$(hostname)" "$1"
}

worktree_dir_for_branch() {
  local root="$1"
  local branch="$2"
  local dir_name="${branch#*/}"
  dir_name="${dir_name//[\/\\]/-}"
  local origin_dir
  origin_dir="$(basename "$root")"

  echo "$(dirname "$root")/$origin_dir-$dir_name"
}

# Default branch of origin (master, main, ...).
default_branch() {
  local d
  d="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)" || d=""
  d="${d#origin/}"
  if [[ -z "$d" ]]; then
    local c
    for c in main master; do
      if git show-ref --verify --quiet "refs/remotes/origin/$c"; then
        d="$c"
        break
      fi
    done
  fi
  printf '%s\n' "${d:-master}"
}

# Integration branch a brand-new branch should fork from, chosen by prefix:
#   hotfix/ release/  -> default branch (the production line)
#   everything else   -> develop when the repo runs gitflow, else default branch
integration_branch_for() {
  case "$1" in
  hotfix/* | release/*) default_branch ;;
  *)
    if git show-ref --verify --quiet refs/remotes/origin/develop; then
      printf 'develop\n'
    else
      default_branch
    fi
    ;;
  esac
}

# Remote-tracking refs that count as "already integrated", newline separated.
upstream_refs() {
  local c seen=""
  for c in "$(default_branch)" develop homolog; do
    [[ "$seen" == *"|$c|"* ]] && continue
    seen="$seen|$c|"
    if git show-ref --verify --quiet "refs/remotes/origin/$c"; then
      printf 'origin/%s\n' "$c"
    fi
  done
}

# True when every commit on <branch> already exists in <upstream>, by ancestry
# OR by patch-id. Bitbucket PR merges rewrite commits, so `git branch --merged`
# alone misses most branches that really did land.
branch_is_upstream() {
  local branch=$1 upstream=$2 out
  out="$(git cherry "$upstream" "$branch" 2>/dev/null)" || return 1
  [[ -z "$out" ]] && return 0
  ! grep -q '^+' <<<"$out"
}

# Emit "<branch>\t<path>" for every worktree with a branch checked out.
worktree_branches() {
  git worktree list --porcelain | awk '
    $1 == "worktree" { sub(/^worktree /, ""); path = $0 }
    $1 == "branch"   { b = $0; sub(/^branch refs\/heads\//, "", b); print b "\t" path }
  '
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_list() {
  git worktree list
}

cmd_path() {
  local branch="${1:-}"
  [[ -z "$branch" ]] && die "Usage: wt path <branch>" 2
  local worktree_dir
  worktree_dir="$(git worktree list --porcelain | awk -v ref="refs/heads/$branch" '
    $1 == "worktree" { sub(/^worktree /, ""); path = $0 }
    $1 == "branch" && $2 == ref { print path; exit }')"
  [[ -n "$worktree_dir" ]] || die "No worktree checked out for branch: $branch" 2
  echo "$worktree_dir"
}

cmd_cd() {
  local branch="${1:-}"
  if [[ -z "$branch" ]]; then
    command -v fzf &>/dev/null || die "wt cd with no branch requires fzf."
    branch=$(worktree_branches | fzf --height 40% --with-nth=1 --delimiter='\t' \
      --preview 'git -C {2} log --oneline --graph --color=always -10' \
      --preview-window right:50% | cut -f1) || return 0
    [[ -n "$branch" ]] || return 0
  fi
  local worktree_dir
  worktree_dir="$(cmd_path "$branch")"
  cd "$worktree_dir"
  report_cwd "$worktree_dir"
  exec "${SHELL:-bash}" -i
}

cmd_remove() {
  local force=0
  while [[ "${1:-}" == -* ]]; do
    case "$1" in
    -f | --force)
      force=1
      shift
      ;;
    *) die "Unknown option: $1" 2 ;;
    esac
  done

  local branch="${1:-}"
  [[ -z "$branch" ]] && die "Usage: wt rm [--force] <branch>" 2

  require_prefix "$branch"

  local worktree_dir
  worktree_dir="$(cmd_path "$branch")"

  # Removal is destructive and unrecoverable: git worktree remove --force
  # deletes the directory outright. Refuse when there is work only living here.
  if [[ $force -eq 0 ]]; then
    [[ -d "$worktree_dir" ]] ||
      die "Worktree directory is missing: $worktree_dir. Use: wt rm --force $branch" 2

    local dirty
    dirty="$(git -C "$worktree_dir" status --porcelain)"
    if [[ -n "$dirty" ]]; then
      die "$worktree_dir has $(grep -c . <<<"$dirty") uncommitted file(s). Commit, stash, or: wt rm --force $branch" 2
    fi

    local upstreams integrated=0 u
    upstreams="$(upstream_refs)"
    for u in $upstreams; do
      if branch_is_upstream "$branch" "$u"; then
        integrated=1
        break
      fi
    done
    if [[ $integrated -eq 0 ]] && ! git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      local ahead
      # shellcheck disable=SC2086 # $upstreams is a deliberate word list of refs
      ahead="$(git rev-list --count "$branch" --not $upstreams)"
      die "$branch has $ahead commit(s) that are neither integrated nor pushed. Push it, or: wt rm --force $branch" 2
    fi
  fi

  info "Removing worktree $worktree_dir"
  if [[ $force -eq 1 ]]; then
    git worktree remove --force "$worktree_dir"
  else
    git worktree remove "$worktree_dir"
  fi

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    info "Deleting branch $branch"
    # -d refuses patch-equivalent merges (PR merges rewrite commits), so -D is
    # the normal path here; the guards above are what make it safe.
    git branch -d "$branch" 2>/dev/null ||
      git branch -D "$branch"
  fi

  success "Done. Remaining worktrees:"
  git worktree list
}

cmd_cleanup() {
  local root
  root="$(repo_root)"

  # Classification is only as good as the remote refs it reads.
  info "Fetching origin"
  git fetch --prune --quiet || info "Fetch failed; classifying against cached refs"

  local upstreams
  upstreams="$(upstream_refs)"
  [[ -n "$upstreams" ]] || die "No integration branch found on origin."

  local integrated=() dirty=() orphaned=()
  local b p u up
  while IFS=$'\t' read -r b p; do
    [[ "$p" == "$root" ]] && continue

    up=""
    for u in $upstreams; do
      if branch_is_upstream "$b" "$u"; then
        up="$u"
        break
      fi
    done

    if [[ -n "$up" ]]; then
      if [[ -d "$p" && -n "$(git -C "$p" status --porcelain)" ]]; then
        dirty+=("$b ${DIM}(in ${up}, uncommitted changes)${RESET}")
      else
        integrated+=("$b ${DIM}(in ${up})${RESET}")
      fi
    elif ! git show-ref --verify --quiet "refs/remotes/origin/$b"; then
      # shellcheck disable=SC2086 # $upstreams is a deliberate word list of refs
      orphaned+=("$b ${DIM}($(git rev-list --count "$b" --not $upstreams) commit(s) only here)${RESET}")
    fi
  done < <(worktree_branches)

  if [[ ${#orphaned[@]} -gt 0 ]]; then
    info "${BOLD}Neither pushed nor integrated${RESET} — untouched, review by hand:"
    printf '  %s\n' "${orphaned[@]}" >&2
  fi
  if [[ ${#dirty[@]} -gt 0 ]]; then
    info "${BOLD}Integrated but dirty${RESET} — untouched, use wt rm --force:"
    printf '  %s\n' "${dirty[@]}" >&2
  fi

  if [[ ${#integrated[@]} -eq 0 ]]; then
    success "Nothing to clean up."
    return
  fi

  info "${BOLD}Integrated and clean${RESET} — safe to remove:"
  printf '  %s\n' "${integrated[@]}" >&2
  local ans
  read -rp "Remove all listed? [y/N] " ans || ans=""
  [[ "$ans" == [yY] ]] || return 0
  for b in "${integrated[@]}"; do cmd_remove "${b%% *}"; done
}

cmd_create() {
  local branch="${1:-}"
  local base="${2:-}"

  [[ -z "$branch" ]] && die "Usage: wt <branch> [base]" 2

  require_prefix "$branch"

  local root
  root="$(repo_root)"
  local worktree_dir
  worktree_dir="$(worktree_dir_for_branch "$root" "$branch")"

  # Pre-flight checks
  [[ -d "$worktree_dir" ]] &&
    die "Directory already exists: $worktree_dir" 2

  local local_exists=0 remote_exists=0
  git show-ref --verify --quiet "refs/heads/$branch" && local_exists=1
  git show-ref --verify --quiet "refs/remotes/origin/$branch" && remote_exists=1

  # Branch not found in any cached ref — it may be a teammate's freshly
  # pushed branch we haven't seen yet. Fetch to check, but only then;
  # this keeps the common case (existing local branch or new branch) fast.
  if [[ $local_exists -eq 0 && $remote_exists -eq 0 ]] && git remote get-url origin &>/dev/null; then
    info "Branch not cached locally; fetching origin"
    git fetch origin --quiet || info "Fetch failed; continuing with local refs"
    git show-ref --verify --quiet "refs/remotes/origin/$branch" && remote_exists=1
  fi

  if [[ $local_exists -eq 0 && $remote_exists -eq 0 ]]; then
    # Truly new branch. With no base given, fork from the integration branch the
    # prefix implies, via its remote-tracking ref (refreshed by the fetch above).
    # Deliberately not the current HEAD: that made the base depend on which
    # worktree wt happened to be invoked from, silently inheriting its drift.
    if [[ -z "$base" ]]; then
      local ib
      ib="$(integration_branch_for "$branch")"
      if git show-ref --verify --quiet "refs/remotes/origin/$ib"; then
        base="origin/$ib"
      else
        base="$ib"
      fi
      info "No base given; forking from ${BOLD}$base${RESET}"
    fi

    # Resolve base (local branch, tag, SHA, or remote-only branch).
    if ! git rev-parse --verify --quiet "$base^{commit}" >/dev/null; then
      if git rev-parse --verify --quiet "origin/$base^{commit}" >/dev/null; then
        base="origin/$base"
      elif git remote get-url origin &>/dev/null; then
        # Base not cached either — could be a base just pushed by a teammate.
        info "Base not cached locally; fetching origin"
        git fetch origin --quiet || info "Fetch failed; continuing with local refs"
        git rev-parse --verify --quiet "origin/$base^{commit}" >/dev/null && base="origin/$base"
      fi
      git rev-parse --verify --quiet "$base^{commit}" >/dev/null || die "Base '$base' not found." 2
    fi
  fi

  if [[ $local_exists -eq 1 ]]; then
    info "Checking out existing local branch ${BOLD}$branch${RESET} into ${BOLD}$worktree_dir${RESET}"
    git worktree add "$worktree_dir" "$branch"
  elif [[ $remote_exists -eq 1 ]]; then
    info "Tracking ${BOLD}origin/$branch${RESET} as ${BOLD}$branch${RESET} in ${BOLD}$worktree_dir${RESET}"
    git worktree add --track -b "$branch" "$worktree_dir" "origin/$branch"
  else
    info "Creating worktree ${BOLD}$worktree_dir${RESET} from ${BOLD}$base${RESET}"
    # --no-track: a new branch forked from origin/develop must not end up
    # tracking origin/develop.
    git worktree add --no-track -b "$branch" "$worktree_dir" "$base"
  fi

  # Copy config files
  local files=(.env .envrc .pre-commit-config.yaml .tool-versions .nvmrc)
  for f in "${files[@]}"; do
    if [[ -f "$root/$f" ]]; then
      cp "$root/$f" "$worktree_dir/$f"
      info "Copied $f"
    fi
  done
  # direnv
  if command -v direnv &>/dev/null && [[ -f "$worktree_dir/.envrc" ]]; then
    info "Running direnv allow"
    (cd "$worktree_dir" && direnv allow)
  fi

  # pre-commit hooks (via prek)
  if command -v prek &>/dev/null && [[ -f "$worktree_dir/.pre-commit-config.yaml" ]]; then
    info "Running prek install"
    (cd "$worktree_dir" && prek install)
  fi

  # codegraph index (only if the main repo already opted in)
  if command -v codegraph &>/dev/null && [[ -d "$root/.codegraph" ]]; then
    info "Running codegraph init"
    codegraph init "$worktree_dir" || info "codegraph init failed; continuing"
  fi

  success "Worktree ready: ${BOLD}$worktree_dir${RESET}"

  # Interactive: pretty output + drop into new worktree.
  # Piped/WT_NO_CD: stdout is just the path so callers can `path=$(wt …)`.
  if [[ -t 1 && -z "${WT_NO_CD:-}" ]]; then
    printf '%b\n\n' "${DIM}Tip: to remove later — wt rm $branch${RESET}"
    git worktree list
    cd "$worktree_dir"
    report_cwd "$worktree_dir"
    exec "${SHELL:-bash}" -i
  else
    echo "$worktree_dir"
  fi
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
"")
  usage
  exit 2
  ;;
esac

require_git_repo

case "$1" in
ls | list) cmd_list ;;
rm | remove) cmd_remove "${@:2}" ;;
cd) cmd_cd "${2:-}" ;;
path) cmd_path "${2:-}" ;;
cleanup) cmd_cleanup ;;
*) cmd_create "$1" "${2:-}" ;;
esac
