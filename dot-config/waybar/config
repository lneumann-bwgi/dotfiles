{
    "layer": "top",
    "spacing": 0,
    "height": 0,

    "margin-top": 8,
    "margin-right": 8,
    "margin-bottom": 0,
    "margin-left": 8,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [
        "tray",
        "wireplumber",
        "cpu",
        "memory",
        "network",
        "battery"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "tooltip": false,
        "format": "{name}"
    },

    "tray": { "spacing": 10, "tooltip": false },

    "clock": {
        "format": "{:%I:%M %p - %a, %d %b %Y}",
        "interval": 60,
        "tooltip": false
    },

    "cpu": {
        "format": "󰻠 {usage:>3}%",
        "interval": 10,
        "states": { "critical": 90 }
    },

    "memory": {
        "format": "󰍛 {percentage:>3}%",
        "interval": 10,
        "states": { "critical": 80 }
    },

    "battery": {
        "bat": "BAT1",
        "format": "󰁹 {capacity:>3}%",
        "format-charging": "󰂄 {capacity:>3}%",
        "format-plugged": "󰁹 {capacity:>3}%",
        "interval": 60,
        "states": { "warning": 20, "critical": 10 },
        "tooltip": false
    },

    "network": {
        "format-wifi": "󰤨 {bandwidthDownBits:>6}",
        "format-ethernet": "󰈀 {bandwidthDownBits:>6}",
        "format-disconnected": "󰤭         ",
        "interval": 3,
        "tooltip": false
    },

    "wireplumber": {
        "scroll-step": 5,
        "max-volume": 100,
        "format": "󰕾 {volume:>3}%",
        "format-muted": "󰖁     ",
        "format-bluetooth": "󰕾 {volume:>3}%",
        "on-click": "pavucontrol",
        "tooltip": false
    }
}
