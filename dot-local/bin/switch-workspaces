#!/bin/bash
set -Eeuo pipefail

# Pick a workspace via wofi, move it to the current monitor, focus it.
# Hyprland >= 0.5x parses dispatch args through Lua, so old C-style
# `focusworkspaceoncurrentmonitor <id>` no longer works — use hl.dsp.*.
sel=$(hyprctl -j workspaces |
  jq -r 'sort_by(.id)[] | "\(.id)\t[\(.monitor)] ws \(.id) — \(.windows) win"' |
  wofi --dmenu |
  cut -f1) || exit 0

# Guard against injection: workspace ids are always integers.
[[ "$sel" =~ ^[0-9]+$ ]] || exit 0

hyprctl dispatch "hl.dsp.workspace.move({workspace=$sel, monitor=\"current\"})"
hyprctl dispatch "hl.dsp.focus({workspace=$sel})"
