#-------------------------------------------------------------------------------
# LOCAL OVERRIDES  (PATH, machine-specific setup)
#-------------------------------------------------------------------------------
[[ -r $ZDOTDIR/local ]] && source $ZDOTDIR/local

#-------------------------------------------------------------------------------
# HOMEBREW  (macOS only)
#-------------------------------------------------------------------------------
[[ -x $HOME/homebrew/bin/brew ]] && eval "$($HOME/homebrew/bin/brew shellenv)"

#-------------------------------------------------------------------------------
# HELPERS
#-------------------------------------------------------------------------------
# Source first readable candidate (brew on macOS, /usr/share on Linux).
_src() { local f; for f in "$@"; do [[ -r $f ]] && { source $f; return } done }

#-------------------------------------------------------------------------------
# HISTORY
#-------------------------------------------------------------------------------

HISTSIZE=1000000000
SAVEHIST=1000000000
HISTORY_IGNORE="(ls|cd|pwd|exit)(| *)"
export HISTFILE="$XDG_STATE_HOME/zsh/history"

setopt EXTENDED_HISTORY      # ':start:elapsed;command' format
setopt HIST_IGNORE_DUPS      # skip immediate repeats
setopt HIST_IGNORE_SPACE     # skip entries starting with space
setopt HIST_REDUCE_BLANKS    # trim superfluous whitespace
setopt HIST_SAVE_NO_DUPS     # dedup on save
setopt HIST_VERIFY           # confirm before running history expansion
setopt INC_APPEND_HISTORY    # append per command, not on exit

#-------------------------------------------------------------------------------
# SHELL OPTIONS
#-------------------------------------------------------------------------------

setopt AUTO_CD               # bare dir name = cd
stty -ixon                   # free Ctrl-S / Ctrl-Q

#-------------------------------------------------------------------------------
# COMPLETIONS
#-------------------------------------------------------------------------------

fpath=($ZDOTDIR/completions $fpath)
autoload -Uz compinit

# Cache compinit: skip insecure-dir scan if zcompdump is <24h old (~100ms saved).
_zdump=$XDG_CACHE_HOME/zsh/zcompdump
if [[ -n $_zdump(#qNmh+24) ]]; then
  compinit -d $_zdump         # stale (>24h) → full security check
else
  compinit -C -d $_zdump      # fresh → skip insecure-dir scan
fi
unset _zdump

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zmodload zsh/complist
_comp_options+=(globdots)

#-------------------------------------------------------------------------------
# VIM MODE  (must precede any tool init that binds keys)
#-------------------------------------------------------------------------------

bindkey -v
export KEYTIMEOUT=1

#-------------------------------------------------------------------------------
# FZF
#-------------------------------------------------------------------------------

source <(fzf --zsh)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS="
    --border
    --color=info:#eacb8a,prompt:#bf6069,pointer:#b48dac
    --height 60%
    --layout=reverse
    --multi
    --preview-window=hidden
    --preview='bat {} --color=always'
    --prompt='❯ ' --pointer='▶ ' --marker='✓ '
    --bind 'ctrl-e:become(nvim {+})'
    --bind 'ctrl-y:execute-silent(echo {+} | pbcopy 2>/dev/null || wl-copy 2>/dev/null || xclip -i 2>/dev/null)'
    --bind 'ctrl-d:preview-down'
    --bind 'ctrl-u:preview-up'
    --bind '?:toggle-preview'"

export FZF_ALT_C_OPTS="--preview 'et -I {}'"
export FZF_CTRL_R_OPTS="--preview-window=hidden"

#-------------------------------------------------------------------------------
# PLUGINS — autosuggestions  (syntax-highlighting loads later, after widgets)
#-------------------------------------------------------------------------------

_src $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
     /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

#-------------------------------------------------------------------------------
# PROMPT + TOOL HOOKS
#-------------------------------------------------------------------------------

eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
eval "$(direnv hook zsh)"
eval "$(atuin init zsh)"

#-------------------------------------------------------------------------------
# ALIASES + FUNCTIONS
#-------------------------------------------------------------------------------

[[ -r $ZDOTDIR/functions ]] && source $ZDOTDIR/functions
[[ -r $ZDOTDIR/aliases ]]   && source $ZDOTDIR/aliases

#-------------------------------------------------------------------------------
# WIDGETS — clipboard yank
#-------------------------------------------------------------------------------

__clip_copy() {
  if command -v wl-copy >/dev/null 2>&1; then
    wl-copy
    return 0
  fi

  if command -v pbcopy >/dev/null 2>&1; then
    pbcopy
    return 0
  fi

  if command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard
    return 0
  fi

  if command -v xsel >/dev/null 2>&1; then
    xsel --clipboard --input
    return 0
  fi

  return 1
}

function vi-yank-to-clipboard() {
  zle vi-yank
  print -rn -- "$CUTBUFFER" | __clip_copy || {
    zle -M "No clipboard tool found (pbcopy/wl-copy/xclip/xsel)."
  }
}
zle -N vi-yank-to-clipboard

#-------------------------------------------------------------------------------
# WIDGETS — vim text objects
#-------------------------------------------------------------------------------

autoload -U select-quoted
zle -N select-quoted

autoload -U select-bracketed
zle -N select-bracketed

#-------------------------------------------------------------------------------
# SYNTAX HIGHLIGHTING  (must be after all `zle -N` — it wraps every widget)
#-------------------------------------------------------------------------------

_src $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
     /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

#-------------------------------------------------------------------------------
# HISTORY SUBSTRING SEARCH  (must be after syntax-highlighting, per its docs)
#-------------------------------------------------------------------------------

_src $HOMEBREW_PREFIX/share/zsh-history-substring-search/zsh-history-substring-search.zsh \
     /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh

#-------------------------------------------------------------------------------
# KEYBINDINGS — vim motions
#-------------------------------------------------------------------------------

bindkey -M vicmd 'H' beginning-of-line
bindkey -M vicmd 'L' end-of-line

bindkey -M vicmd 'y' vi-yank-to-clipboard
bindkey -M visual 'y' vi-yank-to-clipboard

#-------------------------------------------------------------------------------
# KEYBINDINGS — history (atuin)
#-------------------------------------------------------------------------------

bindkey -M vicmd 'k' atuin-up-search-vicmd
bindkey -M vicmd 'j' atuin-down-search-vicmd
bindkey -M vicmd '^R' atuin-search

#-------------------------------------------------------------------------------
# KEYBINDINGS — completion menu (vim keys)
#-------------------------------------------------------------------------------

bindkey -M menuselect 'h' vi-backward-char
bindkey -M menuselect 'k' vi-up-line-or-history
bindkey -M menuselect 'l' vi-forward-char
bindkey -M menuselect 'j' vi-down-line-or-history

#-------------------------------------------------------------------------------
# KEYBINDINGS — widgets  (all Ctrl-<letter>, mnemonic)
#-------------------------------------------------------------------------------
# ^R  Recall     — atuin (default from init)
# ^F  File       — fzf-file
# ^O  Open dir   — fzf-cd            (overrides accept-line-and-down-history)
# ^G  Git files  — fgt-widget        (from functions/)
# ^S  Status     — fgst-widget       (from functions/;  ^S free via stty -ixon)
# ^B  Branch     — gsw-widget        (from functions/;  overrides backward-char)
# ^K  Kill       — fkill             (from functions/)
# ^E  Explain    — fman-widget       (from functions/;  overrides end-of-line)

bindkey '^F' fzf-file-widget
bindkey '^O' fzf-cd-widget
bindkey '^G' fgt-widget
bindkey '^S' fgst-widget
bindkey '^B' gsw-widget
bindkey '^K' fkill-widget
bindkey '^E' fman-widget

# scrub old fzf defaults
bindkey -r '^T'
bindkey -r '\eC'

#-------------------------------------------------------------------------------
# KEYBINDINGS — vim text-object binds  (must be after select-quoted / bracketed)
#-------------------------------------------------------------------------------

# ci', ca", vi`, ...
for m in visual viopp; do
    for c in {a,i}{\',\",\`}; do
        bindkey -M $m $c select-quoted
    done
done

# ci{, ci(, di{, ...
for m in visual viopp; do
    for c in {a,i}${(s..)^:-"()[]{}<>"}; do
        bindkey -M $m $c select-bracketed
    done
done

#-------------------------------------------------------------------------------
# CLEANUP
#-------------------------------------------------------------------------------

unfunction _src
